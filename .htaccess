# Deny direct access to everything except index.php by default.
<IfModule mod_authz_core.c>
    <FilesMatch "^(?!index\.php$).*$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(?!index\.php$).*$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Explicitly block sensitive files/extensions even if the above is bypassed.
<FilesMatch "\.(json|lock|log|md|dist|example)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^config\.local\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
DirectoryIndex index.php
